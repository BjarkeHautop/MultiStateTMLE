treated$A0 <- rbinom(max(treated$id), 1, 0.5)[treated$id]
fit_treated <- fit_initial(
  treated,
  models = list(
    hazard_model(z ~ L0 + A0, limit = 1),
    death ~ L0 + A0 + z,
    censoring ~ L0
